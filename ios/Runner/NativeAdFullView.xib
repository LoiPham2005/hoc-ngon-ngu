<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="22155" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="fulRoot01" customClass="GADNativeAdView">
            <rect key="frame" x="0.0" y="0.0" width="375" height="812"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="fmed-0001" customClass="GADMediaView">
                    <rect key="frame" x="12" y="12" width="351" height="600"/>
                </view>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Ad" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="fbdg-0002">
                    <rect key="frame" x="20" y="20" width="28" height="18"/>
                    <constraints>
                        <constraint firstAttribute="width" constant="28" id="fbw-01"/>
                        <constraint firstAttribute="height" constant="18" id="fbh-01"/>
                    </constraints>
                    <color key="backgroundColor" red="0.98431372549999998" green="0.75294117649999997" blue="0.14117647059999999" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="10"/>
                    <color key="textColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <nil key="highlightedColor"/>
                </label>
                <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="fico-0003">
                    <rect key="frame" x="12" y="624" width="48" height="48"/>
                    <constraints>
                        <constraint firstAttribute="width" constant="48" id="fiw-01"/>
                        <constraint firstAttribute="height" constant="48" id="fih-01"/>
                    </constraints>
                </imageView>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Headline" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="fhed-0004">
                    <rect key="frame" x="68" y="624" width="295" height="26"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="17"/>
                    <color key="textColor" red="0.10980392159999999" green="0.10588235290000001" blue="0.12156862749999999" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <nil key="highlightedColor"/>
                </label>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Advertiser" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="fadv-0005">
                    <rect key="frame" x="68" y="654" width="295" height="18"/>
                    <fontDescription key="fontDescription" type="system" pointSize="13"/>
                    <color key="textColor" red="0.47450980389999999" green="0.45490196080000001" blue="0.49411764709999999" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <nil key="highlightedColor"/>
                </label>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Body" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="3" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="fbod-0006">
                    <rect key="frame" x="12" y="684" width="351" height="52"/>
                    <fontDescription key="fontDescription" type="system" pointSize="14"/>
                    <color key="textColor" red="0.28627450980000001" green="0.27058823530000001" blue="0.30980392159999999" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <nil key="highlightedColor"/>
                </label>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="custom" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="fcta-0007">
                    <rect key="frame" x="12" y="748" width="351" height="48"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="48" id="fch-01"/>
                    </constraints>
                    <color key="backgroundColor" red="0.40392156859999999" green="0.31372549020000001" blue="0.6431372549" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="16"/>
                    <state key="normal" title="Install">
                        <color key="titleColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </state>
                </button>
            </subviews>
            <viewLayoutGuide key="safeArea" id="fsaf-0008"/>
            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <!-- CTA ghim đáy safe area -->
                <constraint firstItem="fcta-0007" firstAttribute="leading" secondItem="fulRoot01" secondAttribute="leading" constant="12" id="fc-01"/>
                <constraint firstAttribute="trailing" secondItem="fcta-0007" secondAttribute="trailing" constant="12" id="fc-02"/>
                <constraint firstItem="fsaf-0008" firstAttribute="bottom" secondItem="fcta-0007" secondAttribute="bottom" constant="16" id="fc-03"/>
                <!-- Body trên CTA -->
                <constraint firstItem="fbod-0006" firstAttribute="leading" secondItem="fulRoot01" secondAttribute="leading" constant="12" id="fc-04"/>
                <constraint firstAttribute="trailing" secondItem="fbod-0006" secondAttribute="trailing" constant="12" id="fc-05"/>
                <constraint firstItem="fcta-0007" firstAttribute="top" secondItem="fbod-0006" secondAttribute="bottom" constant="12" id="fc-06"/>
                <!-- Hàng icon + headline + advertiser trên body -->
                <constraint firstItem="fico-0003" firstAttribute="leading" secondItem="fulRoot01" secondAttribute="leading" constant="12" id="fc-07"/>
                <constraint firstItem="fbod-0006" firstAttribute="top" secondItem="fico-0003" secondAttribute="bottom" constant="12" id="fc-08"/>
                <constraint firstItem="fhed-0004" firstAttribute="leading" secondItem="fico-0003" secondAttribute="trailing" constant="8" id="fc-09"/>
                <constraint firstAttribute="trailing" secondItem="fhed-0004" secondAttribute="trailing" constant="12" id="fc-10"/>
                <constraint firstItem="fhed-0004" firstAttribute="top" secondItem="fico-0003" secondAttribute="top" constant="0.0" id="fc-11"/>
                <constraint firstItem="fadv-0005" firstAttribute="leading" secondItem="fico-0003" secondAttribute="trailing" constant="8" id="fc-12"/>
                <constraint firstAttribute="trailing" secondItem="fadv-0005" secondAttribute="trailing" constant="12" id="fc-13"/>
                <constraint firstItem="fadv-0005" firstAttribute="top" secondItem="fhed-0004" secondAttribute="bottom" constant="4" id="fc-14"/>
                <!-- MediaView fill toàn bộ space còn lại phía trên -->
                <constraint firstItem="fmed-0001" firstAttribute="top" secondItem="fsaf-0008" secondAttribute="top" constant="12" id="fc-15"/>
                <constraint firstItem="fmed-0001" firstAttribute="leading" secondItem="fulRoot01" secondAttribute="leading" constant="12" id="fc-16"/>
                <constraint firstAttribute="trailing" secondItem="fmed-0001" secondAttribute="trailing" constant="12" id="fc-17"/>
                <constraint firstItem="fico-0003" firstAttribute="top" secondItem="fmed-0001" secondAttribute="bottom" constant="12" id="fc-18"/>
                <!-- Badge "Ad" overlay góc trên trái media (bắt buộc theo policy AdMob) -->
                <constraint firstItem="fbdg-0002" firstAttribute="top" secondItem="fmed-0001" secondAttribute="top" constant="8" id="fc-19"/>
                <constraint firstItem="fbdg-0002" firstAttribute="leading" secondItem="fmed-0001" secondAttribute="leading" constant="8" id="fc-20"/>
            </constraints>
            <connections>
                <outlet property="mediaView" destination="fmed-0001" id="fo-1"/>
                <outlet property="iconView" destination="fico-0003" id="fo-2"/>
                <outlet property="headlineView" destination="fhed-0004" id="fo-3"/>
                <outlet property="advertiserView" destination="fadv-0005" id="fo-4"/>
                <outlet property="bodyView" destination="fbod-0006" id="fo-5"/>
                <outlet property="callToActionView" destination="fcta-0007" id="fo-6"/>
            </connections>
            <point key="canvasLocation" x="0" y="0"/>
        </view>
    </objects>
</document>
