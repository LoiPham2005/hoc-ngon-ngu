<?xml version="1.0" encoding="utf-8"?>
<!-- Vòng mục tiêu hôm nay: ProgressBar ngang + vòng xoay từ 12 giờ. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thickness="5dp" android:useLevel="false">
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thickness="5dp" android:useLevel="true">
                <solid android:color="@color/widget_brand" />
            </shape>
        </rotate>
    </item>
</layer-list>
